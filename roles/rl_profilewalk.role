# This role walks the real robot through a fixed profile of walk commands using the quintic walk
# engine. It is used for walk tuning and repeatable walk data collection, where keyboardwalk would
# otherwise need someone to enter the commands by hand.
nuclear_role(
  # FileWatcher, ConsoleLogHandler and Signal Catcher Must Go First and without it many roles do not run
  extension::FileWatcher # Watches configuration files for changes
  support::SignalCatcher # Allows for graceful shutdown
  support::logging::ConsoleLogHandler # `log()` calls show in the console filtered for log level
  support::logging::DataLogging
  # Configuration
  actuation::KinematicsConfiguration # Must go early in the role as other modules depend on it
  # Network
  network::NUClearNet
  network::NetworkForwarder
  network::PlotJuggler
  # Sensors
  input::SensorFilter
  # Director
  extension::Director
  # Servos
  actuation::Servos
  actuation::Kinematics
  actuation::FootController
  # Skills
  skill::RLWalk
  skill::GetUp
  skill::Look
  # Planners
  planning::GetUpPlanner
  planning::FallingRelaxPlanner
  # Strategies
  strategy::FallRecovery
  strategy::StandStill
  # Purpose
  purpose::ProfileWalk
  # Platform
  platform::${SUBCONTROLLER}::HardwareIO
)
