# This role is like test/localisation - you can drive the robot around with the keyboard while it localises
# itself on the field. In addition, it runs the FieldPlayer team behaviour logic purely to report the role it
# *would* take if it were in an actual game (attack, defend, support, etc.) based on where the ball and other
# robots are, and it calculates the support position it would walk to when supporting. These are emitted for
# NUsight (Purpose, SupportPosition and Overview) but do NOT drive the robot - all movement comes from
# KeyboardWalk, so the robot never moves on its own.
nuclear_role(
  # FileWatcher, ConsoleLogHandler and Signal Catcher Must Go First and without it many roles do not run
  extension::FileWatcher # Watches configuration files for changes
  support::SignalCatcher # Allows for graceful shutdown
  # Configuration
  actuation::KinematicsConfiguration # Must go early in the role as other modules depend on it
  support::configuration::GlobalConfig
  support::configuration::SoccerConfig # Field description
  # Network
  network::NUClearNet
  network::NetworkForwarder
  network::PlotJuggler
  # Output
  output::Overview
  output::ImageCompressor
  # Input
  input::K1Camera
  input::NatNet
  input::K1Sensors
  localisation::Mocap
  # Vision vision::VisualMesh vision::GreenHorizonDetector vision::BallDetector vision::FieldLineDetector
  vision::Yolo
  # Localisation
  localisation::BallLocalisation
  localisation::FieldLocalisationNLopt
  localisation::RobotLocalisation
  # Director
  extension::Director
  # Servos
  actuation::Kinematics
  actuation::Servos
  actuation::FootController
  # Skills
  skill::K1Walk
  skill::KickWalk
  skill::K1GetUp
  skill::K1Look
  # Planners
  planning::GetUpPlanner
  planning::FallingRelaxPlanner
  # Strategies
  strategy::FallRecovery
  strategy::StandStill
  # Team behaviour - reports the role and support position it would take, without driving the robot
  purpose::TeamBehaviourTester
  purpose::FieldPlayer
  purpose::Support
  # Purpose - drives the robot around with the keyboard
  purpose::KeyboardWalk
  # Platform
  platform::${SUBCONTROLLER}::HardwareIO
  support::logging::DataLogging
)
