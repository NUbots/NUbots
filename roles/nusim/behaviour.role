# NUSim counterpart of test/behaviour. NUSim ignores the firmware Move/VisualKick RPCs, so walk and kick run as ONNX
# policies (SimK1Walk, SimK1Kick) instead of Walk/KickWalk, and the camera comes from NUSim's shared-memory writer
# (input::NUSimCamera). Sim-only config overrides (NUClearNet multicast, walk-policy velocity caps, Tester priorities)
# live in each module's config/bin/nusim/behaviour/.
nuclear_role(
  # FileWatcher, ConsoleLogHandler and Signal Catcher Must Go First and without it many roles do not run
  extension::FileWatcher # Watches configuration files for changes
  support::SignalCatcher # Allows for graceful shutdown
  support::logging::ConsoleLogHandler # `log()` calls show in the console filtered for log level
  # Configuration
  support::configuration::SoccerConfig # Field description
  # Network
  network::NUClearNet
  network::NetworkForwarder
  network::PlotJuggler
  output::Overview
  output::ImageCompressor
  # Sensors — NUSimCamera (sim seqlock reader) instead of Camera (NUbridge/on-robot). Sensors is shared: NUSim's pose
  # writer still uses the v1 layout it reads.
  input::NUSimCamera
  input::Sensors
  # Vision — Yolo-only, matching the robocup.role hardware pipeline
  vision::Yolo
  # Localisation
  localisation::FieldLocalisationNLopt
  localisation::BallLocalisation
  localisation::RobotLocalisation
  # Director
  extension::Director
  # Servos
  actuation::Servos # Director-arbitrated sink for the K1 low-level channel (walk/kick/getup subsumption)
  # Skills
  skill::SimK1Walk # ONNX walk inference -> LowCmd
  skill::SimK1Kick # ONNX kick inference -> LowCmd (provides skill::Kick)
  skill::SimK1GetUp # ONNX get-up inference -> LowCmd
  skill::Look
  # Planners
  planning::PlanWalkPath
  planning::PlanLook
  planning::PlanKick
  planning::GetUpPlanner
  # Strategies
  strategy::FallRecovery
  strategy::StandStill
  strategy::WalkToFieldPosition
  strategy::StrategiseLook
  strategy::WalkToBall
  strategy::FindObject
  # Purposes
  purpose::Tester
  # Platform — Booster HardwareIO bridges to NUSim's SdkBridge over DDS in sim
  platform::${SUBCONTROLLER}::HardwareIO
)
