# NUSim counterpart of test/localisation: drive the robot around with the keyboard while
# vision and localisation run, so field/ball/robot localisation can be checked against
# NUSim's ground truth. Reads the camera from NUSim's shared-memory writer
# (input::NUSimCamera, lock-free seqlock) instead of the on-robot NUbridge writer
# (input::K1Camera), and drops NatNet/Mocap since sim has no motion capture rig.
nuclear_role(
  # FileWatcher, ConsoleLogHandler and Signal Catcher Must Go First and without it many roles do not run
  extension::FileWatcher # Watches configuration files for changes
  support::SignalCatcher # Allows for graceful shutdown
  support::logging::ConsoleLogHandler # `log()` calls show in the console filtered for log level
  # Configuration
  actuation::KinematicsConfiguration # Must go early in the role as other modules depend on it
  support::configuration::GlobalConfig
  support::configuration::SoccerConfig # Field description
  # Network
  network::NUClearNet
  network::NetworkForwarder
  network::PlotJuggler
  # Output
  output::Overview
  output::ImageCompressor
  # Sensors — NUSimCamera (sim seqlock reader) instead of K1Camera (NUbridge/on-robot).
  # K1Sensors is shared: NUSim's pose writer still uses the v1 layout it reads.
  input::NUSimCamera
  input::K1Sensors
  # Vision — Yolo-only, matching the robocup.role hardware pipeline
  vision::Yolo
  # Localisation
  localisation::BallLocalisation
  localisation::FieldLocalisationNLopt
  localisation::RobotLocalisation
  # Director
  extension::Director
  # Servos
  actuation::K1Servos # Director-arbitrated sink for the K1 low-level channel (walk/getup subsumption)
  # Skills
  skill::SimK1Walk # ONNX walk inference -> LowCmd
  skill::SimK1GetUp # ONNX get-up inference -> LowCmd
  skill::K1Look
  # Planners
  planning::GetUpPlanner
  # Strategies
  strategy::FallRecovery
  strategy::StandStill
  # Purpose
  purpose::KeyboardWalk
  # Platform — Booster HardwareIO bridges to NUSim's SdkBridge over DDS in sim
  platform::${SUBCONTROLLER}::HardwareIO
  support::logging::DataLogging
)
